{
  "extends": "@aaronmacken/typescript-config-react-application-template/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@components": ["components/index"],
      "@components/*": ["components/*"],
      "@context": ["context/index"],
      "@context/*": ["context/*"],
      "@hooks": ["hooks/index"],
      "@hooks/*": ["hooks/*"],
      "@utils": ["utils/index"],
      "@utils/*": ["utils/*"],
      "@constants": ["constants/index"],
      "@constants/*": ["constants/*"],
      "@customTypes": ["customTypes/index"],
      "@customTypes/*": ["customTypes/*"]
    },
    "outDir": "./dist/"
  },
  "include": ["src/**/*"]
}
